# Apollo OCR .env — Tier 2 (Mid-range: 8GB+ GPU, 16GB+ RAM)
# Generated by install/install.py — edit with care

# =============================================================================
# LLM / OLLAMA
# =============================================================================
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_URL_CHAT=http://127.0.0.1:11434
OLLAMA_MODEL_CHAT=qwen2.5vl:7b
OLLAMA_KEEP_ALIVE_CHAT=20m
OLLAMA_NUM_CTX=8192

# =============================================================================
# OCR PRIMARY MODEL
# =============================================================================
APOLLO_GB10_OCR_ENABLED=1
APOLLO_GB10_OCR_TIMEOUT_SEC=180
APOLLO_GB10_QWEN_OCR_MODEL=qwen2.5vl:7b
APOLLO_GB10_QWEN_OCR_FALLBACK_MODEL=qwen2.5vl:3b
APOLLO_GB10_QWEN_OLLAMA_URL=http://127.0.0.1:11434
APOLLO_GB10_OCR_GATEWAY_URL=http://127.0.0.1:5221
APOLLO_GB10_OCR_USE_GATEWAY=1
APOLLO_GB10_OCR_USE_QWEN_CLEANUP=1

# =============================================================================
# AEGIS FEATURE FLAGS
# =============================================================================
AEGIS_OCR_ENGINE_MINERU2_5_READY=1
AEGIS_QWEN_PRECLASSIFY_ENABLE=1
AEGIS_DEPLOT_ENABLE=1
AEGIS_TROCR_ENABLE=1
AEGIS_PADDLEOCR_VL_ALLOW_AUTODOWNLOAD=1

# =============================================================================
# ENSEMBLE / PARALLELISM (reduced for mid-range)
# =============================================================================
AEGIS_SCALE_ENSEMBLE_WORKERS=2
AEGIS_SC_PAGE_WORKERS=2
AEGIS_DPI_ENSEMBLE_WORKERS=2
AEGIS_QWEN_MULTI_IMAGE_MAX_PAGES=4
APOLLO_OCR_SURYA_COLUMN_SPLIT_ENABLED=1

# =============================================================================
# OCR SERVICES
# =============================================================================
APOLLO_OCR_FINBERT_URL=http://127.0.0.1:5221/ocr/finbert/eval
APOLLO_OCR_TABLEFORMER_URL=http://127.0.0.1:5221/ocr/table/reconstruct
APOLLO_OCR_REALESRGAN_URL=http://127.0.0.1:5221/ocr/realesrgan/upscale

# =============================================================================
# SERVER
# =============================================================================
PORT=5218
HOST=0.0.0.0
DEBUG=false
