# Apollo OCR .env — Tier 3 (CPU / GitHub Actions)
# Generated by install/install.py — edit with care
# Qwen is disabled. Active: GOT-OCR2.0, DePlot, TrOCR, FinBERT, TableFormer, PaddleOCR, Tesseract

# =============================================================================
# LLM / OLLAMA — disabled at tier3
# =============================================================================
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=4096

# =============================================================================
# OCR PRIMARY MODEL — Qwen disabled
# =============================================================================
APOLLO_GB10_OCR_ENABLED=0
APOLLO_GB10_QWEN_OCR_MODEL=
APOLLO_GB10_QWEN_OCR_FALLBACK_MODEL=
APOLLO_GB10_QWEN_OLLAMA_URL=http://127.0.0.1:11434
APOLLO_GB10_OCR_GATEWAY_URL=http://127.0.0.1:5221
APOLLO_GB10_OCR_USE_GATEWAY=1
APOLLO_GB10_OCR_USE_QWEN_CLEANUP=0

# =============================================================================
# AEGIS FEATURE FLAGS
# =============================================================================
AEGIS_OCR_ENGINE_MINERU2_5_READY=0
AEGIS_QWEN_PRECLASSIFY_ENABLE=0
AEGIS_DEPLOT_ENABLE=1
AEGIS_TROCR_ENABLE=1
AEGIS_PADDLEOCR_VL_ALLOW_AUTODOWNLOAD=1

# =============================================================================
# ENSEMBLE / PARALLELISM (single-threaded on CI)
# =============================================================================
AEGIS_SCALE_ENSEMBLE_WORKERS=1
AEGIS_SC_PAGE_WORKERS=1
AEGIS_DPI_ENSEMBLE_WORKERS=1
AEGIS_QWEN_MULTI_IMAGE_MAX_PAGES=1
APOLLO_OCR_SURYA_COLUMN_SPLIT_ENABLED=0

# =============================================================================
# OCR SERVICES
# =============================================================================
APOLLO_OCR_FINBERT_URL=http://127.0.0.1:5221/ocr/finbert/eval
APOLLO_OCR_TABLEFORMER_URL=http://127.0.0.1:5221/ocr/table/reconstruct
APOLLO_OCR_REALESRGAN_URL=

# =============================================================================
# SERVER
# =============================================================================
PORT=5218
HOST=0.0.0.0
DEBUG=false
