# Apollo Configuration Template
# Copy this to .env and customize

# LLM Provider (auto, ollama, owui)
LLM_PROVIDER=auto

# Ollama settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
OLLAMA_URL_CHAT=http://127.0.0.1:11434
OLLAMA_MODEL_CHAT=gemma3:12b
OLLAMA_KEEP_ALIVE_CHAT=20m
OLLAMA_URL_DEEP=http://127.0.0.1:11435
OLLAMA_MODEL_DEEP=gemma4:31b
OLLAMA_MODEL_REASON=gemma4:31b

# Apollo GB10 model routing
APOLLO_FAST_LLM_BASE_URL=http://127.0.0.1:11434
APOLLO_FAST_LLM_MODEL=gemma3:12b
APOLLO_HIPPORAG_LLM_MODEL=gemma3:12b
APOLLO_TRADE_REASON_LLM_BASE_URL=http://127.0.0.1:11435
APOLLO_TRADE_REASON_LLM_MODEL=qwen2.5:72b
APOLLO_TRADE_REASON_LLM_FALLBACKS=gemma-3-27b-it-Q4_K_M:latest,gemma-4-26b-a4b-q4km-ctx8:latest,gemma3:12b
APOLLO_TRADE_REASON_LLM_TIMEOUT_SECS=120
APOLLO_MODEL_STORAGE_ROOT=D:\ApolloModels
APOLLO_ALLOW_C_DRIVE_MODEL_DOWNLOADS=0
OLLAMA_MODELS=D:\ApolloModels\ollama

# Server defaults
PORT=5010
HOST=127.0.0.1
DEBUG=false
SKY_ALLOW_ANON=0
ARGUS_ALERTS_EXTERNAL_URL=http://127.0.0.1:5216/alerts/external

# Apollo watchlist (comma-separated)
APOLLO_WATCHLIST=NVDA,AMD,AVGO,TSM,MSFT,AMZN,GOOGL,META,JPM,GS,BAC,XOM,CVX,LLY,UNH,JNJ,CAT,HON

# OpenWebUI settings
OWUI_URL=http://127.0.0.1:3000
OWUI_MODEL=gemma4:31b

# Model config for legacy config.py consumers
MODEL_NAME=gemma4:31b
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=gemma4:31b

# RAG weight tuning (financial-optimized)
# Higher similarity weight for precise matches
RAG_SIM_WEIGHT=0.4
# Priority weight for recent/important docs
RAG_PRI_WEIGHT=0.4
# Age decay for time-sensitive financial data
RAG_AGE_WEIGHT=0.2

# Background pipeline defaults
APOLLO_NIGHTLY_MAX_ARTICLES=4
APOLLO_BACKGROUND_INTERVAL_MIN=10
APOLLO_BACKGROUND_MAX_ACTIVE_MODELS=2
APOLLO_BACKGROUND_MIN_IDLE_SEC=300

# Simulation execution controls
APOLLO_PAPER_PORTFOLIO_SIZE=100
APOLLO_SIM_RISK_PER_TRADE_DOLLARS=1
APOLLO_SIM_MAX_POSITION_QTY=50
APOLLO_SIM_MIN_POSITION_QTY=1
APOLLO_SIM_MAX_OPEN_POSITIONS=5
APOLLO_SIM_SIMULATED_BUYING_POWER=100
