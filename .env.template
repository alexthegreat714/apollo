# Apollo Configuration Template
# Copy this to .env and customize

# LLM Provider (auto, ollama, owui)
LLM_PROVIDER=auto

# Ollama settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=fino:7b-q8

# OpenWebUI settings
OWUI_URL=http://127.0.0.1:3000
OWUI_MODEL=fino:7b-q8

# RAG weight tuning (financial-optimized)
# Higher similarity weight for precise matches
RAG_SIM_WEIGHT=0.4
# Priority weight for recent/important docs
RAG_PRI_WEIGHT=0.4
# Age decay for time-sensitive financial data
RAG_AGE_WEIGHT=0.2
